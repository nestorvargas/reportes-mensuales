# Example environment file for Complemento360
# Do NOT store real credentials here. Copy to `.env` and fill secrets locally.

DATABASE_URL=postgresql+asyncpg://c360:REPLACE_ME@localhost:5433/complemento360
SECRET_KEY=replace-with-secure-key
APP_USER=your_user
APP_PASSWORD=your_password

# SMTP (outgoing mail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@example.com
# Copia (Cc) en todos los envíos, separadas por coma
EMAIL_CC=copia@example.com

# Documento soporte GAF-FOR-015 (plantilla de Complemento 360; contiene datos personales, no va en git)
# DOCUMENTO_SOPORTE_TEMPLATE=../reportes_mensuales/plantillas/GAF-FOR-015_documento_soporte.xlsx
# DOCUMENTO_SOPORTE_CLIENTE=Colcomercio

# Contactos sugeridos en el modal de correo (separados por coma)
EMAIL_CONTACTS=Diego Restrepo <diego.restrepo@complemento360.com>

# Other settings
# DEBUG=false
